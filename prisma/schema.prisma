generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 소셜 로그인 연결
  accounts Account[]
  sessions Session[]

  profile           UserProfile?
  diagnoses         LevelDiagnosis[]
  quizAttempts      UserQuizAttempt[]
  vocabularies      UserVocabulary[]
  flashcardSessions FlashcardSession[]

  // Phase 1-5 추가
  league       UserLeague?
  achievements UserAchievement[]

  // Phase 2: 상점
  purchases UserPurchase[]

  // P4: 승급 시험
  promotionAttempts LevelPromotionAttempt[]
  promotionSessions LevelPromotionSession[]

  // P2-1: 리스닝
  quizSessions QuizSession[]
}

model Account {
  id                    String    @id
  userId                String
  providerId            String
  accountId             String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  level         String    @default("A1") // CEFR 레벨
  totalXP       Int       @default(0)
  lastStudyDate DateTime?
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)

  // 약점 영역 (JSON): {"동사": 45.5, "형용사": 30.0}
  weaknessAreas Json?

  // 어휘 학습 통계
  totalWordLearned Int @default(0)
  masteredWords    Int @default(0)
  reviewNeeded     Int @default(0)

  // Phase 1-5 추가
  freezeCount          Int @default(0)
  lastMilestoneGranted Int @default(0)
  dailyGoalMinutes     Int @default(10)
  dailyGoalWords       Int @default(15)

  // Phase 2: 상점 통화 (소비 가능 XP — totalXP와 별개로 차감됨)
  spendableXP Int @default(0)

  // Phase 2-v2: 상점 v2 소모품 재고
  freeHintCount  Int @default(0) // 프리 힌트 보유량 (힌트 팩 구매로 증가)
  xpBoostCharges Int @default(0) // 퀴즈 2배 충전권 보유량 (퀴즈 완료 시 자동 소비)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum QuestionDifficulty {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum QuestionCategory {
  daily
  business
  toeic
  travel
  idioms
}

model QuizQuestion {
  id               String             @id @default(cuid())
  koreanHint       String // 한글 힌트
  contextHintKo    String? // 상황 설명 힌트 (한국어)
  englishWord      String // 정답 영어 단어
  sentence         String // 문맥 문장 (빈칸 포함)
  sentenceAudioUrl String? // 완성 문장(빈칸→정답) 발음 오디오 R2 URL
  difficulty       QuestionDifficulty
  category         QuestionCategory

  options  QuizOption[]
  attempts UserQuizAttempt[]

  createdAt DateTime @default(now())

  @@unique([difficulty, englishWord])
  @@index([difficulty, category])
}

model UserQuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  timeSpent      Int // 초 단위
  hintLevel      Int      @default(0) // 0(없음), 1(상황), 2(전체)
  attemptedAt    DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, attemptedAt])
}

model WeaknessArea {
  id          String @id @default(cuid())
  diagnosisId String
  category    String // 동사, 형용사, 명사 등(약점 영역)
  accuracy    Float // 정확도 %

  diagnosis LevelDiagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@index([diagnosisId])
}

model LevelDiagnosis {
  id          String   @id @default(cuid())
  userId      String
  totalScore  Int // 0-100
  cefrLevel   String // A1, A2, B1, B2, C1, C2
  completedAt DateTime @default(now())

  weaknessAreas WeaknessArea[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean
  order      Int // 1-4

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// 어휘 콘텐츠 모델
model Vocabulary {
  id              String           @id @default(cuid())
  word            String           @unique
  meaning         String
  pronunciation   String?
  exampleSentence String?
  category        String // daily, business, toeic, travel
  level           String // A1-C2
  audioUrl        String?
  exampleAudioUrl String?
  userProgress    UserVocabulary[]
  createdAt       DateTime         @default(now())

  @@index([level, category])
  @@map("vocabularies")
}

// 사용자 어휘 진행 상황 (SRS 핵심)
model UserVocabulary {
  id             String     @id @default(cuid())
  userId         String
  vocabularyId   String
  masteryLevel   String     @default("new")
  repetitions    Int        @default(0)
  easeFactor     Float      @default(2.5)
  interval       Int        @default(1)
  lastReviewDate DateTime?
  nextReviewDate DateTime   @default(now())
  totalReviews   Int        @default(0)
  correctCount   Int        @default(0)
  incorrectCount Int        @default(0)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([userId, vocabularyId])
  @@index([userId, nextReviewDate])
  @@index([userId, masteryLevel])
  @@map("user_vocabularies")
}

// Phase 1-5 게이미피케이션 모델
model UserLeague {
  id           String   @id @default(cuid())
  userId       String   @unique
  tier         Int      @default(1) // 1=Bronze, 2=Silver, 3=Gold, 4=Platinum, 5=Diamond, 6=Master
  leaguePoints Int      @default(0)
  joinedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tier, leaguePoints])
  @@map("user_leagues")
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String
  category    String // learning, streak, accuracy, league, special
  requirement Int
  xpReward    Int    @default(50)

  userAchievements UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
  @@map("user_achievements")
}

// 플래시카드 세션 추적
model FlashcardSession {
  id              String   @id @default(cuid())
  userId          String
  mode            String
  vocabularyCount Int
  accuracy        Float
  duration        Int
  easyCount       Int      @default(0)
  normalCount     Int      @default(0)
  hardCount       Int      @default(0)
  forgotCount     Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@map("flashcard_sessions")
}

// Phase 2: 상점 구매 이력
model UserPurchase {
  id          String   @id @default(cuid())
  userId      String
  itemCode    String // shop-items.ts의 code와 매칭
  xpCost      Int // 구매 시점 가격 기록
  purchasedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purchasedAt])
  @@index([userId, itemCode])
}

// P4: 승급 시험 응시 기록 — 쿨다운 판정과 이력의 근거.
// UserQuizAttempt 에 기록하지 않는 이유: 데일리 퀴즈 완료 판정(hasCompletedTodayQuiz)이
// UserQuizAttempt 카운트라서 시험 응시가 "오늘 퀴즈 완료"로 오인된다.
model LevelPromotionAttempt {
  id           String   @id @default(cuid())
  userId       String
  fromLevel    String // 제출 트랜잭션의 락 안에서 다시 읽은 현재 레벨 (= CAS 조건값). 시작 시점 값이 아니다
  toLevel      String // 목표 레벨 (fromLevel 의 다음)
  correctCount Int // 10문항 중 정답 수
  passed       Boolean
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// P4: 응시 세션 — "진행률 100% 관문을 통과했다"는 서버 측 증거이자 채점 대상 문항의 고정.
// 이 모델이 없으면 start(자격 검증)를 건너뛰고 submit 만 직접 호출해 진행률 0% 에서도 승급할 수 있고,
// 제출 문항을 사용자가 임의로 고를 수 있다 — difficulty 검증은 "다음 레벨 문항인가"만 보장한다.
// Attempt 와 분리하는 이유: 쿨다운 질의가 LevelPromotionAttempt{passed:false} 를 세므로,
// 시작 시점에 attempt 행을 만들면 응시 시작만으로 쿨다운에 걸린다.
model LevelPromotionSession {
  id          String    @id @default(cuid())
  userId      String
  toLevel     String // 발급 시점의 목표 레벨 (제출 시 getNextLevel(현재 레벨)과 대조)
  questionIds String[] // 발급한 10문항 — 제출 집합이 이것과 정확히 일치해야 한다
  createdAt   DateTime  @default(now())
  consumedAt  DateTime? // 채점된 제출로 소진된 시각(통과·미달 무관). 가드 거절은 롤백이라 채우지 않는다

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// 데일리 퀴즈 세션 기록 — 리스닝 도입 후 "듣기를 얼마나·얼마나 잘 하는가"의 유일한 관측 지점.
//   UserQuizAttempt 는 문항 단위 기록이라 유형별 집계를 담지 못하고, 리스닝은 애초에
//   그 테이블에 기록되지 않는다(questionId 가 QuizQuestion 에 대한 non-nullable FK).
//   로드맵 P2 종료 조건의 "세션 기록"에 대응하되 mode enum 이 아니라 유형별 카운트로 만족시킨다 —
//   한 세션에 읽기·듣기가 섞이므로 FlashcardSession.mode 같은 단일 enum 은 표현할 수 없다.
model QuizSession {
  id               String   @id @default(cuid())
  userId           String
  readingCount     Int // 채점된 읽기 문항 수
  readingCorrect   Int
  listeningCount   Int // 0 이면 오디오 토글로 껐거나 재료가 없던 세션
  listeningCorrect Int
  // 세션 소요 시간(초). 제출 body 에 세션 단위 duration 이 없으므로 서버가 answers 의
  //   timeSpent 를 합산해 채운다 — 클라이언트 계약 무변경.
  //   (플래시카드는 body 로 duration 을 받는다: flashcard/review/route.ts. 퀴즈 제출 body 는
  //    { answers } 뿐이라 같은 방식을 쓰려면 계약을 바꿔야 한다.)
  durationSec      Int
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 갭 집계가 listeningCount > 0 인 세션을 createdAt desc 로 최근 N건만 본다.
  @@index([userId, createdAt])
  @@map("quiz_sessions")
}
